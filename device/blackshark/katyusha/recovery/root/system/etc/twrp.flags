# TWRP-specific partitions and flags for katyusha.
# flashimg=1 exposes a partition in "Install Image". Deliberately NOT flashable here:
# persist, EFS (modemst/fsg/fsc), super, xbl/abl/tz and other bootloader-chain partitions.
#
#<mnt_point>     <type>  <device>                                          <flags>
/system_root     ext4    system                                            flags=display="System";backup=1;wipeingui
/vendor          erofs   vendor                                            flags=display="Vendor";backup=1
/odm             erofs   odm                                               flags=display="ODM"
/vendor_dlkm     erofs   vendor_dlkm                                       flags=display="Vendor DLKM"
/metadata        ext4    /dev/block/bootdevice/by-name/metadata            flags=display="Metadata";backup=1

# Boot chain images (slot-aware)
/boot            emmc    /dev/block/bootdevice/by-name/boot                flags=slotselect;backup=1;flashimg=1;display="Boot"
/vendor_boot     emmc    /dev/block/bootdevice/by-name/vendor_boot         flags=slotselect;backup=1;flashimg=1;display="Vendor Boot"
/recovery        emmc    /dev/block/bootdevice/by-name/recovery            flags=slotselect;backup=1;flashimg=1;display="Recovery"
/dtbo            emmc    /dev/block/bootdevice/by-name/dtbo                flags=slotselect;backup=1;flashimg=1;display="DTBO"
/vbmeta          emmc    /dev/block/bootdevice/by-name/vbmeta              flags=slotselect;backup=1;flashimg=1;display="VBMeta"
/vbmeta_system   emmc    /dev/block/bootdevice/by-name/vbmeta_system       flags=slotselect;backup=1;flashimg=1;display="VBMeta System"

# Firmware (read-only mounts; backup only)
/firmware        vfat    /dev/block/bootdevice/by-name/modem               flags=slotselect;display="Firmware";fsflags="ro,shortname=lower";mounttodecrypt
/modem           emmc    /dev/block/bootdevice/by-name/modem               flags=slotselect;backup=1;display="Modem"
/bluetooth       emmc    /dev/block/bootdevice/by-name/bluetooth           flags=slotselect;backup=1;subpartitionof=/modem
/dsp             emmc    /dev/block/bootdevice/by-name/dsp                 flags=slotselect;backup=1;subpartitionof=/modem

# Device-unique data (backup only, never flashable from the GUI)
/persist         ext4    /dev/block/bootdevice/by-name/persist             flags=display="Persist";backup=1
/efs1            emmc    /dev/block/bootdevice/by-name/modemst1            flags=backup=1;display="EFS"
/efs2            emmc    /dev/block/bootdevice/by-name/modemst2            flags=backup=1;subpartitionof=/efs1
/efsg            emmc    /dev/block/bootdevice/by-name/fsg                 flags=backup=1;subpartitionof=/efs1
/efsc            emmc    /dev/block/bootdevice/by-name/fsc                 flags=backup=1;subpartitionof=/efs1

# Removable storage. UFS uses sda-sdf, so the first USB mass-storage device is sdg.
/usb_otg         auto    /dev/block/sdg1  /dev/block/sdg                   flags=display="USB OTG";storage;wipeingui;removable
