# Black Shark 5 Pro (katyusha) TWRP init
# Based on the stock recovery's init.recovery.qcom.rc (see device-info/stock-recovery/).
# Touch, display, USB and charger modules are loaded by first-stage init from the
# vendor_boot ramdisk (lib/modules/modules.load.recovery); the audio DSP modules below
# are shipped in this ramdisk exactly as in stock recovery.

import /init.recovery.qcom_decrypt.rc

on early-init
    insmod /vendor/lib/modules/q6_pdr_dlkm.ko
    insmod /vendor/lib/modules/q6_notifier_dlkm.ko
    insmod /vendor/lib/modules/snd_event_dlkm.ko
    insmod /vendor/lib/modules/gpr_dlkm.ko
    insmod /vendor/lib/modules/spf_core_dlkm.ko
    insmod /vendor/lib/modules/adsp_loader_dlkm.ko

on init
    write /sys/class/backlight/panel0-backlight/brightness 1200
    setprop sys.usb.configfs 1

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    wait /sys/class/udc/${ro.boot.usbcontroller} 1

# USB OTG: dwc3-msm "mode" only accepts peripheral/host/none. The write above sets
# the initial role; afterwards ucsi_glink drives a600000.ssusb-role-switch, which flips
# the controller to host mode when an OTG drive is attached (same path as Android).

on fs
    # TWRP only searches /system/lib64 (+ /vendor/lib64/hw). Vendor blobs in this ramdisk
    # (boot control HAL deps, touch daemon libs) live in /vendor/lib64.
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1
    mkdir /vendor/firmware_mnt
    mkdir /vendor/firmware
    mount_all /vendor/etc/charger_fstab.qti --early
    mount none /vendor/firmware_mnt/image /vendor/firmware bind rec
    wait /sys/kernel/boot_adsp/boot
    write /sys/kernel/boot_adsp/boot 1
    wait /sys/class/power_supply/battery

# Touch: hbp_touch is a FocalTech "host-based processing" panel. The kernel driver only
# exposes raw frames (/dev/ht_ft); Black Shark's htd daemon computes touch points and
# injects them through /dev/ht_input ("ht,input" event device). Android starts it after
# boot_completed (vendor/etc/init/com.blackshark.htd@1.0-service.rc); it registers a HIDL
# service, so hwservicemanager must be running.
service vendor.htd /vendor/bin/hw/com.blackshark.htd@1.0-service
    user root
    group root system
    capabilities SYS_NICE
    disabled
    setenv LD_LIBRARY_PATH /system/lib64:/vendor/lib64
    seclabel u:r:recovery:s0

on boot
    mkdir /data/vendor 0771 root root
    mkdir /data/vendor/syna 0770 system system
    start hwservicemanager
    # Boot control for slot switching. The VINTF fragments declare the boot HAL over
    # hwbinder, so TWRP's IBootControl::getService() needs this service running. It
    # loads the QTI impl (/vendor/lib64/hw/android.hardware.boot@1.0-impl-1.2-qti.so)
    # via passthrough; verified live on build #6.
    start boot-hal-1-2
    wait /dev/ht_input 10
    chmod 0666 /dev/ht_input
    chown system system /dev/ht_input
    start vendor.htd

# Haptics: the Awinic aw86907 driver exposes the leds-vibrator interface (duration +
# activate) on its i2c device, not under /sys/class/leds/vibrator where TWRP looks.
# Overlay /sys/class/leds with a tmpfs holding a "vibrator" link to the device (TWRP
# does not use the RGB/flash LEDs this hides). The driver also needs its RAM waveform
# aw8697_haptic.bin (shipped in /etc/firmware, loaded into chip RAM at boot; nothing
# is written to flash), otherwise it refuses to play ("ram init failed").
on boot
    mount tmpfs tmpfs /sys/class/leds mode=0755
    symlink /sys/devices/platform/soc/884000.i2c/i2c-3/3-005a /sys/class/leds/vibrator

# Back RGB light (two Awinic aw2023 controllers, i2c-4 and i2c-5). It comes up green;
# the green channels must be written first to switch it off, then it is set to a
# TWRP-style sky blue (B 255, G 100, chosen on-device) to show TWRP is running.
# Direct device paths (/sys/class/leds is overlaid above).
on boot
    write /sys/devices/platform/soc/890000.i2c/i2c-4/4-0045/leds/green1/brightness 0
    write /sys/devices/platform/soc/988000.i2c/i2c-5/5-0045/leds/green2/brightness 0
    write /sys/devices/platform/soc/890000.i2c/i2c-4/4-0045/leds/blue1/brightness 255
    write /sys/devices/platform/soc/988000.i2c/i2c-5/5-0045/leds/blue2/brightness 255
    write /sys/devices/platform/soc/890000.i2c/i2c-4/4-0045/leds/green1/brightness 100
    write /sys/devices/platform/soc/988000.i2c/i2c-5/5-0045/leds/green2/brightness 100

# ---- FBE decryption (phase 2) ----
# qseecomd, keymaster 4.1 and gatekeeper services come from device/qcom/twrp-common
# (qcom_decrypt / qcom_decrypt_fbe). Stock also runs KeyMint (AIDL) and the QSEECom
# HAL; TWRP's vold talks to KeyMint through keystore2, so add those here. Vendor
# binaries live in /system/bin and their libraries in /vendor/lib64 (twrp-common layout).
on init
    setprop vendor.gatekeeper.disable_spu true

on fs
    chmod 0666 /dev/smcinvoke
    chown system drmrpc /dev/smcinvoke

service vendor.keymint-qti /system/bin/android.hardware.security.keymint-service-qti
    user root
    group root drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib
    disabled
    seclabel u:r:recovery:s0

service vendor.qseecom-service /system/bin/vendor.qti.hardware.qseecom@1.0-service
    user root
    group root drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib
    disabled
    seclabel u:r:recovery:s0

# qseecomd registers its listeners (RPMB, secure storage, ...) and then sets this prop.
on property:vendor.sys.listeners.registered=true
    start vendor.qseecom-service
    start vendor.keymint-qti

on property:twrp.all.users.decrypted=true
    stop vendor.keymint-qti
    stop vendor.qseecom-service
