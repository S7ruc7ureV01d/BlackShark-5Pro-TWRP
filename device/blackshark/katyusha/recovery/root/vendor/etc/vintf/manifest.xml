<!--
    Minimal device VINTF manifest for recovery. hwservicemanager only accepts HIDL
    registrations listed in a manifest, and it does not read the manifest/ fragment
    directory unless this main file exists. Without it the Black Shark touch daemon
    (com.blackshark.htd) fails registerAsService and exits, leaving touch dead.
-->
<manifest version="2.0" type="device" target-level="6">
    <hal format="hidl">
        <name>com.blackshark.htd</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IHostTouchDaemon</name>
            <instance>default</instance>
        </interface>
    </hal>
</manifest>
