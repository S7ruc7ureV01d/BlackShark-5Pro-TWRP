<!--
    Minimal device VINTF manifest for recovery. hwservicemanager only accepts HIDL
    registrations listed in a manifest, and it does not read the manifest/ fragment
    directory unless this main file exists. Without it the Black Shark touch daemon
    (com.blackshark.htd) fails registerAsService and exits, leaving touch dead.
-->
<manifest version="2.0" type="device" target-level="6">
    <hal format="hidl">
        <name>com.blackshark.htd</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IHostTouchDaemon</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Security HALs for FBE decryption (from stock /vendor/etc/vintf) -->
    <hal format="hidl">
        <name>android.hardware.gatekeeper</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::IGatekeeper/default</fqname>
    </hal>
    <hal format="hidl">
        <name>android.hardware.keymaster</name>
        <transport>hwbinder</transport>
        <fqname>@4.1::IKeymasterDevice/default</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.qti.hardware.qseecom</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::IQSEECom/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.security.keymint</name>
        <fqname>IKeyMintDevice/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.security.keymint</name>
        <fqname>IRemotelyProvisionedComponent/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.security.sharedsecret</name>
        <fqname>ISharedSecret/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.security.secureclock</name>
        <fqname>ISecureClock/default</fqname>
    </hal>
</manifest>
