# katyusha USB gadget (configfs only). Replaces TWRP's legacy android_usb
# init.recovery.usb.rc (TW_EXCLUDE_DEFAULT_USB_INIT := true). The adb, sideload and
# fastboot configurations come from TWRP's init.rc; this file adds what it lacks.
# See device-info/twrp-boot-3 for the failure these rules fix.

on fs && property:sys.usb.configfs=1
    # MTP over FunctionFS (TWRP's MTP server writes descriptors to /dev/usb-ffs/mtp/ep0
    # and then sets sys.usb.ffs.mtp.ready=1). The kernel has no f_mtp (mtp.gs0).
    mkdir /config/usb_gadget/g1/functions/ffs.mtp
    mkdir /dev/usb-ffs/mtp 0770 mtp mtp
    mount functionfs mtp /dev/usb-ffs/mtp rmode=0770,fmode=0660,uid=1024,gid=1024,no_disconnect=1

# TWRP's init.rc restarts adbd when service.adb.root=1. The old adbd had already set
# sys.usb.ffs.ready=1, so the adb trigger bound the UDC against a dead FunctionFS
# instance (-ENODEV) and never re-fired, because the new adbd sets the same value.
# Reset it so the new adbd's "ready" is a real property change.
on property:service.adb.root=1
    setprop sys.usb.ffs.ready 0

on property:sys.usb.config=none && property:sys.usb.configfs=1
    rm /config/usb_gadget/g1/configs/b.1/f2
    setprop sys.usb.ffs.mtp.ready 0

on property:sys.usb.config=adb && property:sys.usb.configfs=1
    rm /config/usb_gadget/g1/configs/b.1/f2

on property:sys.usb.config=mtp,adb && property:sys.usb.configfs=1
    start adbd

on property:sys.usb.config=mtp,adb && property:sys.usb.ffs.ready=1 && property:sys.usb.ffs.mtp.ready=1 && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/UDC "none"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/idProduct 0x4EE2
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=mtp && property:sys.usb.ffs.mtp.ready=1 && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/UDC "none"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/idProduct 0x4EE1
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp"
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}
